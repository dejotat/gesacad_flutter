# Datos de la base de la NUBE (Clever Cloud) para docker/migrar-desde-nube.ps1
# Copia este archivo como .env.nube, completa los valores y NO lo subas a git (ya está ignorado).
# Los valores están en el panel de Clever Cloud → tu add-on de MySQL → "Information".
# El script solo LEE de esta base; nunca la modifica.
NUBE_HOST=xxxxxxxx-mysql.services.clever-cloud.com
NUBE_PORT=3306
NUBE_USER=
NUBE_PASS=
NUBE_DB=
