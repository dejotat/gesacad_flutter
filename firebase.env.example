# Configuración de Firebase para las notificaciones push (CU-13).
# Copia este archivo como "firebase.env" (NO se sube a git) y pega TUS valores.
# Dónde están: consola de Firebase → Configuración del proyecto → General → "Tus apps" (Android).
#
# Son identificadores públicos de tu proyecto (van dentro del APK); el secreto es la
# cuenta de servicio del SERVIDOR, que va en Render como FIREBASE_SERVICE_ACCOUNT.

FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=

# Versión que se envía al servidor al registrar el teléfono (opcional).
APP_VERSION=1.0.0
