# =============================================================================
# GESACAD · Configuración de Docker (plantilla)
# =============================================================================
# Cópiala como ".env" (en esta misma carpeta) y completa los valores. El archivo .env NO se
# sube a git. Atajo que lo crea con contraseñas aleatorias:  .\docker\iniciar.ps1
# (Linux/Mac:  ./docker/iniciar.sh)
# =============================================================================

# ── Base de datos (dos contraseñas DISTINTAS y largas; mejor solo letras y números) ──
DB_NAME=bdgesacad
DB_USER=gesacad
DB_PASS=
MYSQL_ROOT_PASSWORD=

# ── Seguridad ──
# Firma las sesiones. Aleatorio, mínimo 16 caracteres. Generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Primer administrador ──
# Se crea SOLO si la base no tiene ningún administrador (la base nueva no trae cuentas).
# La contraseña: 8-64 caracteres con mayúscula, minúscula, número y símbolo, sin el usuario.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ── Archivos de las entregas (opcional) ──
# Cuenta gratuita de cloudinary.com. Sin esto TODO funciona menos subir archivos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Asistente GESACAD (opcional): clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Notificaciones push (opcional) ──
# JSON de la cuenta de servicio de Firebase en base64 (ver Backend/.env.example).
FIREBASE_SERVICE_ACCOUNT=

# ── Puerto de MySQL en ESTE equipo (para Workbench/DBeaver/HeidiSQL) ──
# Solo escucha en 127.0.0.1. No es el 3306 para no chocar con un MySQL local.
# Usuario y contraseña: DB_USER y DB_PASS de arriba; base: DB_NAME.
DB_HOST_PORT=3307

# ── Dirección de la API para el NAVEGADOR ──
# Se graba al compilar la web. Si cambias el puerto o publicas el sistema en un servidor, pon
# aquí su dirección pública y reconstruye:  docker compose up -d --build web
API_BASE_URL=http://localhost:8081
